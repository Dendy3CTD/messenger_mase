[Unit]
Description=mase probeserver (пробный сервер для netprobe)
After=network.target

[Service]
User=mase
Group=mase
EnvironmentFile=/etc/mase-probe/env
ExecStart=/usr/local/bin/mase-probeserver
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=128M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
